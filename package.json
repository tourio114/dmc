{
  "name": "dmc-download",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler dev --compatibility-date 2026-05-22",
    "build": "node scripts/build-worker.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "wrangler": "4.92.0",
    "miniflare": "4.20260515.0"
  }
}
